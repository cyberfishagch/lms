  "css": "@page { size: A4 landscape; margin: 0; }\nbody { margin: 0; padding: 0; }\n\n.certificate-container {\n  position: relative;\n  width: 100%;\n  min-height: 19cm;\n  padding: 2.8cm 3cm;\n  background-color: #ffffff;\n  color: #0f172a;\n  font-family: Helvetica, Arial, sans-serif;\n  text-align: center;\n  box-sizing: border-box;\n  border-top: 12px solid #002B50;\n  border-bottom: 12px solid #002B50;\n}\n\n.cert-corner {\n  position: absolute;\n  width: 80px;\n  height: 80px;\n  border: 2px solid #002B50;\n}\n.cert-corner-tl { top: 36px;    left: 36px;  border-right: none; border-bottom: none; }\n.cert-corner-tr { top: 36px;    right: 36px; border-left:  none; border-bottom: none; }\n.cert-corner-bl { bottom: 36px; left: 36px;  border-right: none; border-top:    none; }\n.cert-corner-br { bottom: 36px; right: 36px; border-left:  none; border-top:    none; }\n\n.cert-brand { margin-bottom: 1.4cm; }\n.cert-brand-logo { height: 48px; width: auto; display: inline-block; }\n\n.cert-eyebrow {\n  font-size: 11px;\n  letter-spacing: 0.38em;\n  text-transform: uppercase;\n  color: #64748b;\n  font-weight: 600;\n}\n\n.cert-rule {\n  width: 80px;\n  height: 3px;\n  background-color: #D70F0A;\n  margin: 0.6cm auto 1cm;\n}\n\n.cert-presented {\n  font-size: 14px;\n  color: #64748b;\n  letter-spacing: 0.04em;\n  margin-bottom: 0.5cm;\n}\n\n.cert-name {\n  font-family: Georgia, \"Times New Roman\", serif;\n  font-size: 52px;\n  font-weight: 400;\n  color: #002B50;\n  line-height: 1.1;\n  margin-bottom: 0.8cm;\n  letter-spacing: -0.01em;\n}\n\n.cert-body {\n  font-size: 14px;\n  color: #475569;\n  margin-bottom: 0.6cm;\n}\n\n.cert-course {\n  font-size: 22px;\n  font-weight: 700;\n  color: #0f172a;\n  letter-spacing: -0.01em;\n  margin-bottom: 1.6cm;\n  max-width: 70%;\n  margin-left: auto;\n  margin-right: auto;\n}\n\n.cert-footer {\n  display: table;\n  width: 100%;\n  margin-top: 0.6cm;\n}\n.cert-footer-col {\n  display: table-cell;\n  text-align: left;\n  vertical-align: top;\n  width: 33.33%;\n}\n.cert-footer-col-center { text-align: center; }\n.cert-footer-col-right  { text-align: right; }\n\n.cert-footer-label {\n  font-size: 10px;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: #94a3b8;\n  font-weight: 600;\n  margin-bottom: 4px;\n}\n.cert-footer-value {\n  font-size: 13px;\n  color: #0f172a;\n  font-weight: 500;\n}\n.cert-footer-mono {\n  font-family: \"Courier New\", monospace;\n  font-size: 11px;\n  color: #64748b;\n  font-weight: 400;\n  letter-spacing: 0.02em;\n}",
